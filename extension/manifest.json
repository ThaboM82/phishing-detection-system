{
  "manifest_version": 3,
  "name": "Phishing Detector Guard",
  "version": "1.0.0",
  "description": "Real-time hybrid ML and heuristic phishing link analyzer.",
  "permissions": [
    "activeTab",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Phishing Inspector"
  }
}